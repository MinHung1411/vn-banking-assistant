# Copy file này thành .env rồi điền giá trị thật, KHÔNG commit .env lên git

# Tạo API key tại https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

# 2 model đã fine-tune, push lên HuggingFace Hub
ASPECT_MODEL_REPO=minhunhooo/phobert-banking-aspect
SENTIMENT_MODEL_REPO=minhunhooo/phobert-banking-sentiment

# Thư mục chứa Chroma index (giải nén từ chroma_banking_news.zip tải về từ Kaggle output)
CHROMA_PERSIST_DIR=./chroma_banking_news
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
